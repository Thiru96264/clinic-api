# Copy this file to ".env" and fill in your own values
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Replace <password> and keep the database name (clinic) in the path.
MONGODB_URI=mongodb+srv://clinicuser:<password>@cluster0.xxxxx.mongodb.net/clinic?retryWrites=true&w=majority

# Optional
PORT=3000
# If set, every request except /health must send header: x-api-key: <value>
API_KEY=
